{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Frontend Handbook",
  "colors": {
    "primary": "#3B82F6",
    "light": "#60A5FA",
    "dark": "#2563EB"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Introduction",
            "pages": ["index", "quickstart", "development"]
          }
        ]
      },
      {
        "tab": "HTML",
        "groups": [
          {
            "group": "Fundamentals",
            "pages": [
              "html/introduction",
              "html/elements",
              "html/attributes",
              "html/structure"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "html/semantic",
              "html/accessibility",
              "html/forms",
              "html/best-practices"
            ]
          }
        ]
      },
      {
        "tab": "CSS",
        "groups": [
          {
            "group": "Basics",
            "pages": [
              "css/introduction",
              "css/selectors",
              "css/box-model",
              "css/typography"
            ]
          },
          {
            "group": "Layout",
            "pages": [
              "css/flexbox",
              "css/grid",
              "css/responsive",
              "css/positioning"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "css/animations",
              "css/variables",
              "css/preprocessors",
              "css/frameworks"
            ]
          }
        ]
      },
      {
        "tab": "JavaScript",
        "groups": [
          {
            "group": "Fundamentals",
            "pages": [
              "javascript/introduction",
              "javascript/syntax",
              "javascript/variables",
              "javascript/functions",
              "javascript/objects",
              "javascript/arrays"
            ]
          },
          {
            "group": "DOM",
            "pages": [
              "javascript/dom-manipulation",
              "javascript/events",
              "javascript/forms"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "javascript/async",
              "javascript/fetch-api",
              "javascript/modules",
              "javascript/es6-features"
            ]
          }
        ]
      },
      {
        "tab": "Tools & Frameworks",
        "groups": [
          {
            "group": "Development Tools",
            "pages": [
              "tools/git",
              "tools/package-managers",
              "tools/bundlers",
              "tools/devtools"
            ]
